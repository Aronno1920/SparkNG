{
    "name": "@bdspark/sparkng",
    "version": "22.1.1",
    "author": "bdSpark",
    "description": "SparkNG is a community-maintained, MIT licensed UI library for Angular with 80+ accessible components and design-agnostic theming, including Aura, Material, Lara, Nora and Shadcn presets, maintained by bdSpark.",
    "homepage": "https://sparkng.bdspark.com/",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Aronno1920/SparkNG.git",
        "directory": "packages/sparkng"
    },
    "bugs": {
        "url": "https://github.com/Aronno1920/SparkNG/issues"
    },
    "keywords": [
        "Spark",
        "sparkng",
        "angular",
        "ui library",
        "component library",
        "material",
        "bootstrap",
        "fluent",
        "tailwind"
    ],
    "publishConfig": {
        "directory": "dist",
        "linkDirectory": false,
        "access": "public"
    },
    "schematics": "./schematics/collection.json",
    "ng-add": {
        "save": "dependencies"
    },
    "ng-update": {
        "migrations": "./schematics/migrations.json",
        "packageGroup": [
            "@bdspark/sparkng-icons",
            "@bdspark/sparkng",
            "@bdspark/sparkng-charts",
            "@bdspark/sparkng-locale",
            "@bdspark/sparkng-motion",
            "@bdspark/sparkng-styled",
            "@bdspark/sparkng-styles",
            "@bdspark/sparkng-tailwindcss",
            "@bdspark/sparkng-themes",
            "@bdspark/sparkng-utils"
        ]
    },
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && ng build sparkng && pnpm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "build:schematics": "node ./scripts/build-schematics.mjs",
        "test:schematics": "node ./scripts/build-schematics.mjs && vitest run --config vitest.schematics.config.mts",
        "dev:link": "pnpm link --global && npm link",
        "lint": "ng lint",
        "test:unit": "ng run sparkng:test-vitest --watch=false",
        "test:unit:watch": "ng run sparkng:test-vitest --watch",
        "test:unit:coverage": "ng run sparkng:test-vitest --watch=false --coverage"
    },
    "devDependencies": {
        "@angular-devkit/schematics": "^22.1.6",
        "@angular/build": "catalog:angular22",
        "@schematics/angular": "^22.1.6",
        "@types/node": "^26.2.0",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.1",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.12",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.2",
        "prosemirror-view": "^1.42.6",
        "tslib": "^2.8.1",
        "typescript": "catalog:angular22",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@angular/cdk": "catalog:angular22",
        "@angular/common": "catalog:angular22",
        "@angular/core": "catalog:angular22",
        "@angular/forms": "catalog:angular22",
        "@angular/platform-browser": "catalog:angular22",
        "@angular/router": "catalog:angular22",
        "prosemirror-commands": "^1.7.0",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.0",
        "prosemirror-keymap": "^1.2.0",
        "prosemirror-model": "^1.25.0",
        "prosemirror-schema-list": "^1.5.0",
        "prosemirror-state": "^1.4.0",
        "prosemirror-tables": "^1.8.0",
        "prosemirror-transform": "^1.12.0",
        "prosemirror-view": "^1.42.0",
        "rxjs": "^6.0.0 || ^7.8.1"
    },
    "dependencies": {
        "@bdspark/sparkng-motion": "workspace:*",
        "@bdspark/sparkng-styled": "workspace:*",
        "@bdspark/sparkng-styles": "workspace:*",
        "@bdspark/sparkng-utils": "workspace:*"
    }
}
