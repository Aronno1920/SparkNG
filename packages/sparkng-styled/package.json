{
    "name": "@bdspark/sparkng-styled",
    "version": "22.26.3",
    "author": "bdSpark",
    "description": "Styled utilities for SparkNG Libraries for Angular v22",
    "keywords": ["styled", "css", "style utilities", "Spark", "angular"],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Aronno1920/SparkNG.git",
        "directory": "packages/sparkng-styled"
    },
    "bugs": {
        "url": "https://github.com/Aronno1920/SparkNG/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": ["dist", "README.md", "LICENSE"],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:dev:package",
        "build:package": "tsdown",
        "build:dev:package": "tsdown --watch",
        "dev:link": "pnpm link --global && npm link",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@bdspark/sparkng-utils": "workspace:*"
    },
    "devDependencies": {
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=12.11.0"
    }
}
