{
    "name": "@bdspark/sparkng-monorepo",
    "version": "22.1.1",
    "author": "bdSpark",
    "homepage": "https://sparkng.bdspark.com/",
    "repository": {
        "type": "git",
        "url": "https://github.com/Aronno1920/SparkNG.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Aronno1920/SparkNG/issues"
    },
    "scripts": {
        "clean": "npx rimraf --glob **/node_modules **/dist **/.angular ./pnpm-lock.yaml",
        "link": "pnpm --filter \"./packages/*\" dev:link",
        "release": "pnpm run build && pnpm recursive publish --filter \"./packages/*\" --no-git-checks --access public --report-summary",
        "release:beta": "pnpm run build && pnpm recursive publish --filter \"./packages/*\" --no-git-checks --access public --report-summary --tag beta",
        "release:rc": "pnpm run build && pnpm recursive publish --filter \"./packages/*\" --no-git-checks --access public --report-summary --tag rc",
        "build": "cross-env NODE_ENV=production pnpm run build:check && pnpm run build:packages",
        "build:check": "pnpm run format:check && pnpm run security:check",
        "build:packages": "pnpm run build:sparkng && pnpm run build:lib && pnpm run build:themes && pnpm run build:docs:content && pnpm run build:docs",
        "build:sparkng": "pnpm --filter \"./packages/sparkng-*\" build",
        "build:lib": "pnpm --filter @bdspark/sparkng build",
        "build:themes": "pnpm --filter @bdspark/sparkng-themes build",
        "build:docs": "pnpm --filter docs build",
        "build:docs:content": "pnpm --filter docs build:docs",
        "dev": "pnpm --filter docs start",
        "dev:ssr": "pnpm --filter docs start:ssr",
        "dev:tw3": "pnpm --filter tailwindcss-v3-playground dev",
        "dev:tw4": "pnpm --filter tailwindcss-v4-playground dev",
        "security:check": "pnpm audit --prod --audit-level high --ignore GHSA-vfj7-8cjw-p6xm",
        "format": "prettier --write \"packages/**/*.{js,mjs,ts,mts,d.ts,html}\" \"apps/**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "format:check": "prettier --check \"packages/**/*.{js,mjs,ts,mts,d.ts,html}\" \"apps/**/*.{js,mjs,ts,mts,d.ts,html}\"",
        "lint": "eslint --ext \".js,.mjs,.ts,.mts\" --ignore-path .gitignore . --cache",
        "lint:fix": "eslint --fix --ext \".js,.mjs,.ts,.mts\" --ignore-path .gitignore .",
        "test:unit": "pnpm run build:sparkng && pnpm --filter @bdspark/sparkng test:unit",
        "test:coverage": "pnpm run build:sparkng && pnpm --filter @bdspark/sparkng test:unit:coverage",
        "test:styled": "pnpm --filter @bdspark/sparkng-utils build && pnpm --filter @bdspark/sparkng-styled test"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "catalog:angular22",
        "@angular-eslint/eslint-plugin": "catalog:angular22",
        "@angular-eslint/eslint-plugin-template": "catalog:angular22",
        "@angular-eslint/schematics": "catalog:angular22",
        "@angular-eslint/template-parser": "catalog:angular22",
        "@angular/animations": "catalog:angular22",
        "@angular/cdk": "catalog:angular22",
        "@angular/cli": "catalog:angular22",
        "@angular/common": "catalog:angular22",
        "@angular/compiler": "catalog:angular22",
        "@angular/compiler-cli": "catalog:angular22",
        "@angular/core": "catalog:angular22",
        "@angular/forms": "catalog:angular22",
        "@angular/platform-browser": "catalog:angular22",
        "@angular/platform-browser-dynamic": "catalog:angular22",
        "@angular/platform-server": "catalog:angular22",
        "@angular/router": "catalog:angular22",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@bdspark/sparkng-motion": "workspace:*",
        "@bdspark/sparkng-styled": "workspace:*",
        "@bdspark/sparkng-styles": "workspace:*",
        "@bdspark/sparkng-themes": "workspace:*",
        "@bdspark/sparkng-utils": "workspace:*",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsdoc": "^64.2.1",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^5.5.6",
        "fs-extra": "^11.4.0",
        "glob": "^13.0.6",
        "lefthook": "^2.1.10",
        "ng-packagr": "catalog:angular22",
        "prettier": "^3.9.6",
        "tsdown": "^0.22.9",
        "typescript": "catalog:angular22"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
